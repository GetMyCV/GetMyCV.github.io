# Copy to .env.local for local development. Every value here is public — it is
# inlined into the static bundle — so in GitHub these belong in repository
# *variables*, not secrets.

# Web3Forms access key. Orders are emailed to the address you registered.
# Free key from https://web3forms.com. Can also be set in content/site.ts.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional: the Cloudflare Worker in /worker, once deployed. Takes precedence
# over Web3Forms and adds a real database plus CV uploads.
# NEXT_PUBLIC_ORDERS_API=https://getmycv-orders.<your-subdomain>.workers.dev

# Optional: cookieless analytics. Leave unset to ship no analytics script at all.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=getmycv.github.io
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
