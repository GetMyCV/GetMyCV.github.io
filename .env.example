# Copy to .env.local for local development.
# In GitHub, store both as repository secrets — the deploy workflow passes them
# to `npm run build`, which inlines them into the static bundle.
#
# The anon key is a public, insert-only key by design; row-level security in
# supabase/schema.sql is what keeps orders unreadable from the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: cookieless analytics. Leave unset to ship no analytics script at all.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=getmycv.github.io
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
